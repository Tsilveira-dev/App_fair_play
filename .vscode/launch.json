{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fair Play: iniciar TESTE",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev.mjs",
      "cwd": "${workspaceFolder}",
